# Copy these into Vercel → your project → Settings → Environment Variables
# (DATABASE_URL is added automatically when you create the Neon database from Storage tab)

DATABASE_URL=postgres://...          # auto-filled by the Neon integration — you shouldn't need to type this
ADMIN_USERNAME=admin                 # the username you'll type on the admin login page
ADMIN_PASSWORD=choose-a-strong-password
SESSION_SECRET=any-long-random-string-you-make-up
